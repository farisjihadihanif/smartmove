# Salin ke .env lalu isi. Jangan commit .env.
NODE_ENV=development
PORT=4200
MONGO_URL=mongodb+srv://<user>:<pass>@<cluster>/smartmove
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_DAYS=7
CLIENT_ORIGIN=http://localhost:5173
APP_URL=http://localhost:4200

# Akun admin dibuat otomatis saat server start bila belum ada
ADMIN_EMAIL=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Peta & rute (OpenStreetMap)
# OSRM per profil (mobil & motor / jalan kaki). Produksi ramai: pasang OSRM sendiri.
OSRM_URL_CAR=https://routing.openstreetmap.de/routed-car
OSRM_URL_FOOT=https://routing.openstreetmap.de/routed-foot
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_EMAIL=
OVERPASS_URL=https://overpass-api.de/api/interpreter
MAPILLARY_TOKEN=

# Midtrans (kunci SANDBOX saja)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# Email (Gmail SMTP)
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Di luar produksi: console (bawaan, email hanya ditulis di log) atau smtp (hanya dikirim ke ADMIN_EMAIL)
MAIL_MODE=console
CONTACT_EMAIL=

# Opsional: server DNS untuk Node bila lookup mongodb+srv gagal (querySrv ECONNREFUSED), mis. 1.1.1.1,8.8.8.8
DNS_SERVERS=

# Opsional: folder foto profil (default api/uploads) & batas percobaan login per 15 menit
UPLOAD_DIR=
AUTH_RATE_LIMIT=20
