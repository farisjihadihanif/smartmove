# Salin ke .env lalu isi. Jangan commit .env.
NODE_ENV=development
PORT=4200
MONGO_URL=mongodb+srv://<user>:<pass>@<cluster>/smartmove
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_DAYS=7
# Origin web (CORS + tautan). Produksi: URL Vercel, mis. https://smartmove-medan.vercel.app (boleh dipisah koma).
CLIENT_ORIGIN=http://localhost:5173
# URL web publik (tautan reset password di email). Produksi: URL Vercel.
APP_URL=http://localhost:4200
# Produksi di Render: 1 (satu proxy di depan API).
TRUST_PROXY=1
# lax (bawaan, web lewat rewrite Vercel) | none (web memanggil API lintas domain langsung)
COOKIE_SAMESITE=lax
# Kota aktif (api/src/cities). Bawaan: medan.
CITY=medan

# Akun admin dibuat otomatis saat server start bila belum ada
ADMIN_EMAIL=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Peta & rute (OpenStreetMap)
# OSRM per profil (mobil & motor / jalan kaki). Produksi ramai: pasang OSRM sendiri.
OSRM_URL_CAR=https://routing.openstreetmap.de/routed-car
OSRM_URL_FOOT=https://routing.openstreetmap.de/routed-foot
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_EMAIL=
OVERPASS_URL=https://overpass-api.de/api/interpreter
MAPILLARY_TOKEN=

# Midtrans (kunci SANDBOX saja)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# Email. MAIL_PROVIDER: smtp (bawaan, dev lokal) | brevo | resend (API HTTP, untuk Render free
# yang memblokir port SMTP). MAIL_FROM = alamat pengirim yang sudah diverifikasi di penyedia.
MAIL_PROVIDER=smtp
MAIL_FROM=
BREVO_API_KEY=
RESEND_API_KEY=
# Gmail SMTP (MAIL_PROVIDER=smtp)
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Di luar produksi: console (bawaan, email hanya ditulis di log) atau smtp (dikirim lewat MAIL_PROVIDER, hanya ke ADMIN_EMAIL)
MAIL_MODE=console
CONTACT_EMAIL=

# Opsional: server DNS untuk Node bila lookup mongodb+srv gagal (querySrv ECONNREFUSED), mis. 1.1.1.1,8.8.8.8
DNS_SERVERS=

# Opsional: folder berkas lama di disk (unggahan baru disimpan di MongoDB GridFS) & batas percobaan login per 15 menit
UPLOAD_DIR=
AUTH_RATE_LIMIT=20
