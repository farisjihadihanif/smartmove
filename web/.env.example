# Alamat API. KOSONGKAN di Vercel: vercel.json meneruskan /api/* ke Render, jadi cookie
# login tetap satu domain (first-party). Kosong juga saat dev (proxy Vite → localhost:4200).
# Isi hanya bila web memanggil API di domain lain secara langsung (perlu COOKIE_SAMESITE=none di API).
VITE_API_URL=
# Kota aktif (src/lib/kota.js). Bawaan: medan.
VITE_CITY=medan
